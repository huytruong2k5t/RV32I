#!/bin/bash
# Script chay mo phong cho moi truong Bash (Git Bash, WSL, MSYS2)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/03_sim"

# Lam sach va tao moi thu vien work
vdel -all -lib work 2>/dev/null || true
vlib work

echo "==================================================="
echo "[1/2] Compiling design and testbench..."
echo "==================================================="
vlog -sv -mfcu +incdir+../01_bench ../00_src/*.sv ../01_bench/tlib.svh ../01_bench/*.sv
if [ $? -ne 0 ]; then
    echo "[ERROR] Compilation failed!"
    exit 1
fi

if [ "$1" == "gui" ]; then
    echo "==================================================="
    echo "[2/2] Launching ModelSim GUI with Waveforms..."
    echo "==================================================="
    vsim -gui -do "do gui.do" work.tbench &
else
    echo "==================================================="
    echo "[2/2] Running ModelSim in CLI mode..."
    echo "==================================================="
    vsim -c -do "do sim.do" work.tbench
fi
